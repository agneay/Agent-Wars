# Copy to .env (local) or set these in your host's dashboard. Never commit real values.
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# Option A: one connection URL (Railway/Aiven/TiDB). Railway also injects MYSQL_URL automatically.
# DATABASE_URL=mysql://user:password@host:3306/aai_asset
# Option B: individual settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aai_asset
# Hosted databases usually require TLS:
DB_SSL=false

# Frontend origin(s) allowed to call the API when hosted, comma-separated
# CORS_ORIGIN=https://aai-assetflow.example.workers.dev

# Optional: Claude fallback for free-form requests
# ANTHROPIC_API_KEY=
